{
  "name": "hermes-control-desk",
  "private": true,
  "version": "0.1.0",
  "description": "Hermes Control Desk — web, Electron, and Windows WPF controller for the Hermes Memory OS VPS",
  "author": "lordamos",
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --port=3000 --host=0.0.0.0",
    "server": "tsx server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server release",
    "lint": "tsc --noEmit",
    "test": "tsx --test server/ssh.test.ts",
    "desktop": "node scripts/desktop.mjs",
    "desktop:pack": "node scripts/desktop-build.mjs && electron-builder --linux dir",
    "desktop:pack:win": "node scripts/desktop-build.mjs && electron-builder --win portable zip"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "isomorphic-fetch": "^3.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.8",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.hermes.control-desk",
    "productName": "Hermes Control Desk",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "dist/**",
      "dist-server/**",
      "package.json",
      "!**/node_modules/**"
    ],
    "asar": true,
    "asarUnpack": [
      "dist-server/**"
    ],
    "linux": {
      "target": ["dir"],
      "category": "Network"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "Hermes-Control-Desk-${version}.exe"
    }
  }
}
